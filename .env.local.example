# Copy to .env.local and fill in real values. Never commit .env.local.
# The site itself runs with none of these set; each section says what stops working without it.
# Anything set here must also be set in Netlify's dashboard (Site configuration > Environment
# variables, Production), or the live site won't see it.

# --- Site ---
# Public address, used for the canonical URLs, sitemap, robots.txt and share image.
NEXT_PUBLIC_SITE_URL=https://psychedelicreadiness.com

# --- Email (the site's forms: PRI correction suggestions, Facilitator Index submissions) ---
# Resend API key. Without it the forms say they couldn't send and offer Tony's email address.
RESEND_API_KEY=
# Optional sender. Default "Only Time Buys Trust <trust@tonygreenberg.com>" (the domain verified in
# Resend). Set it once psychedelicreadiness.com is verified, e.g.
# "Psychedelic Readiness Index <hello@psychedelicreadiness.com>".
EMAIL_FROM=

# --- MCP server (/api/mcp): lets Claude Code / Claude Desktop / Claude.ai / ChatGPT edit this
# site's code (github.com/RRTONY/psychedelicreadiness, fixed in src/lib/admin/site-config.ts) as a
# pull request on an admin/mcp-* branch. See docs/ai/project_mcp_server.md.
# Fine-grained GitHub token scoped to RRTONY/psychedelicreadiness only: Contents + Pull requests =
# Read and write, Actions + Commit statuses = Read. Mind its expiry date.
GITHUB_TOKEN=
# JSON array, one entry per person, role read | edit | write. Email lets them sign in on
# /oauth/authorize; token is optional (64 hex, `openssl rand -hex 32`) for Claude Code's fixed header:
# [{"name":"Jane Doe","email":"jane@example.com","role":"write","token":"<optional>"}]
MCP_ADMIN_USERS=
# Shared team password for the /oauth/authorize sign-in page. Changing it signs everyone out.
MCP_LOGIN_PASSWORD=
# Signs sign-in codes and access tokens, from `openssl rand -hex 32`. Never reuse another secret.
MCP_OAUTH_SECRET=
# Optional. Public origin the OAuth metadata advertises (e.g. https://psychedelicreadiness.com).
MCP_PUBLIC_ORIGIN=
# Optional. Extra comma-separated hosts allowed as sign-in callbacks (claude.ai, claude.com,
# chatgpt.com, chat.openai.com and localhost are always allowed).
MCP_OAUTH_REDIRECT_HOSTS=
# Optional. Origin seo_check_page fetches. Until the domain points at Netlify, set it to the
# Netlify site URL. Falls back to NEXT_PUBLIC_SITE_URL.
MCP_SITE_ORIGIN=

# --- Netlify (MCP check_deploy, read-only; preview links) ---
# Netlify project name: previews are deploy-preview-N--<name>.netlify.app. Default psychedelicreadiness.
NETLIFY_SITE_NAME=
# Netlify site ID (Netlify sets SITE_ID itself on the deployed site, so this is mainly for local).
NETLIFY_SITE_ID=
# Personal access token; check_deploy only ever reads this site's deploys.
NETLIFY_AUTH_TOKEN=
